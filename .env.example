# Snowflake connection (required)
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-username
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/your/rsa_key.p8
# A least-privilege pipeline role (see README "Least-privilege role"), not SYSADMIN
SNOWFLAKE_ROLE=LLM_PIPELINE_ROLE

# Snowflake connection (optional, defaults shown)
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=LLM_PIPELINE_PROD
